From 21a1198ca1cd4c82207faca888e361f89cd831cb Mon Sep 17 00:00:00 2001
From: Vignesh Raman <vignesh.raman@collabora.com>
Date: Wed, 21 Oct 2026 18:57:15 +0530
Subject: [PATCH] wifi: schedule an unrestricted scan after resume

After suspend-resume, the first post-resume scan is restricted
to last associated frequency, but only schedules the unrestricted
follow-up scan when that restricted scan is explicit.

Schedule the follow-up scan right away when the AP is not found,
whether the restricted scan was explicit or periodic. When it is
found, let auto-activation proceed normally, and keep scheduling the
follow-up scan after activation only if the restricted scan was
explicit. Discard the pending follow-up if the connection attempt
ends without activating.
---
 src/core/devices/wifi/nm-device-wifi.c | 68 +++++++++++++++++++++-----
 1 file changed, 55 insertions(+), 13 deletions(-)

diff --git a/src/core/devices/wifi/nm-device-wifi.c b/src/core/devices/wifi/nm-device-wifi.c
index 804d580feb..2ccaa392a9 100644
--- a/src/core/devices/wifi/nm-device-wifi.c
+++ b/src/core/devices/wifi/nm-device-wifi.c
@@ -91,6 +91,8 @@ typedef struct {
 
     NMWifiAP *current_ap;
 
+    NMConnection *last_connection_before_sleep;
+
     GHashTable *scan_request_ssids_hash;
     CList       scan_request_ssids_lst_head;
 
@@ -140,6 +142,7 @@ typedef struct {
     bool hidden_probe_scan_warn : 1;
     bool use_last_freq_for_next_scan : 1;
     bool scan_followup_requested : 1;
+    bool scan_followup_was_explicit : 1;
     bool scan_followup_bypass_ratelimit : 1;
 
     bool addressing_running_indicated : 1;
@@ -494,6 +497,28 @@ _scan_notify_is_scanning(NMDeviceWifi *self)
 
     nm_gobject_notify_together(self, PROP_SCANNING, last_scan_changed ? PROP_LAST_SCAN : PROP_0);
 
+    if (!scanning && priv->scan_followup_requested && state <= NM_DEVICE_STATE_DISCONNECTED) {
+        if (priv->last_connection_before_sleep
+            && nm_wifi_aps_find_first_compatible(&priv->aps_lst_head,
+                                                  priv->last_connection_before_sleep)) {
+            _LOGD(LOGD_WIFI,
+                  "wifi-scan: restricted post-resume scan found the previous AP");
+            /* Let the device auto-activate normally. If the restricted scan
+             * was explicit, the unrestricted follow-up scan is scheduled
+             * once activation succeeds, in device_state_changed(). */
+        } else {
+            _LOGD(LOGD_WIFI,
+                  "wifi-scan: restricted post-resume scan did not find the previous AP");
+            /* The AP was not found. Schedule the unrestricted follow-up scan
+             * right away, whether the restricted scan was explicit or periodic. */
+            priv->scan_followup_requested        = FALSE;
+            priv->scan_explicit_requested        = TRUE;
+            priv->scan_followup_bypass_ratelimit = TRUE;
+        }
+
+        g_clear_object(&priv->last_connection_before_sleep);
+    }
+
     _scan_kickoff(self);
 
     if (!_scan_is_scanning_eval(priv)) {
@@ -695,6 +720,7 @@ supplicant_interface_release(NMDeviceWifi *self)
 
     priv->use_last_freq_for_next_scan    = FALSE;
     priv->scan_followup_requested        = FALSE;
+    priv->scan_followup_was_explicit     = FALSE;
     priv->scan_followup_bypass_ratelimit = FALSE;
 
     _scan_request_ssids_remove_all(priv, 0, 0);
@@ -1941,13 +1967,13 @@ _scan_kickoff(NMDeviceWifi *self)
                   scan_freqs[0]);
             priv->last_freq_before_sleep      = 0;
             priv->use_last_freq_for_next_scan = FALSE;
-            if (is_explict) {
-                /* This explicit scan was restricted to a single channel.
-                 * Schedule an unrestricted explicit scan to trigger once
-                 * the device is connected (ACTIVATED), bypassing the rate
-                 * limit. */
-                priv->scan_followup_requested = TRUE;
-            }
+            /* This scan was restricted to a single channel. Schedule an
+             * unrestricted follow-up scan: right away if the AP isn't
+             * found, or once activation succeeds if it is found and this
+             * scan was explicit. See _scan_notify_is_scanning() and
+             * device_state_changed(). */
+            priv->scan_followup_requested    = TRUE;
+            priv->scan_followup_was_explicit = is_explict;
         }
 
         priv->scan_request_cancellable = g_cancellable_new();
@@ -3722,6 +3748,10 @@ device_state_changed(NMDevice           *device,
     if (new_state == NM_DEVICE_STATE_DEACTIVATING && reason == NM_DEVICE_STATE_REASON_SLEEPING
         && priv->current_ap) {
         priv->last_freq_before_sleep = nm_wifi_ap_get_freq(priv->current_ap);
+
+        g_clear_object(&priv->last_connection_before_sleep);
+        priv->last_connection_before_sleep =
+            nm_g_object_ref(nm_device_get_applied_connection(device));
     }
 
     if (new_state <= NM_DEVICE_STATE_UNAVAILABLE) {
@@ -3761,13 +3791,17 @@ device_state_changed(NMDevice           *device,
         break;
     case NM_DEVICE_STATE_ACTIVATED:
         activation_success_handler(device);
+
         if (priv->scan_followup_requested) {
-            /* The device just connected using a post-resume restricted
-             * scan's results. Now that activation succeeded, queue the
-             * unrestricted full scan. */
-            priv->scan_followup_requested        = FALSE;
-            priv->scan_explicit_requested        = TRUE;
-            priv->scan_followup_bypass_ratelimit = TRUE;
+            priv->scan_followup_requested = FALSE;
+            if (priv->scan_followup_was_explicit) {
+                /* The device just connected using a post-resume restricted
+                 * scan's results, and that restricted scan was an explicit
+                 * request. Now that activation succeeded, queue the
+                 * unrestricted follow-up scan. */
+                priv->scan_explicit_requested        = TRUE;
+                priv->scan_followup_bypass_ratelimit = TRUE;
+            }
         }
 
 #if WITH_IWD
@@ -3781,6 +3815,13 @@ device_state_changed(NMDevice           *device,
         _indicate_addressing_running_reset(self);
         break;
     case NM_DEVICE_STATE_DISCONNECTED:
+        if (priv->scan_followup_requested) {
+            /* The device found the previous AP via a restricted post-resume
+             * scan, but the activation attempt failed. Discard the pending
+             * follow-up scan. */
+            priv->scan_followup_requested    = FALSE;
+            priv->scan_followup_was_explicit = FALSE;
+        }
         break;
     default:
         break;
@@ -4028,6 +4069,7 @@ dispose(GObject *object)
     cleanup_supplicant_failures(self);
 
     g_clear_object(&priv->sup_mgr);
+    g_clear_object(&priv->last_connection_before_sleep);
 
     remove_all_aps(self, TRUE);
 
-- 
