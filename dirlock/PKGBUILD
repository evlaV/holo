pkgver() {
  cd "$srcdir/$pkgname"

  echo 0.0.1.$(git rev-list --count HEAD).$(git rev-parse --short HEAD)
}

prepare() {
  cd "$srcdir"

  holo-vendor-rust-sources -o vendored -L "$pkgname/Cargo.lock" *.tar.gz

  cd "$pkgname"

  mkdir -pv .cargo

  cat <<-EOF > .cargo/config.toml
	[source."crates-io"]
	replace-with = "vendored-sources"

	[source.vendored-sources]
	directory = "${srcdir}/vendored"
	EOF
}

build () {
  make -C "$srcdir/holo-dirlock-extras"

  cd "$srcdir/$pkgname"
  cargo build -F tpm2,fido2,dbus --offline --release --target-dir target
}

package() {
  make -C "$srcdir/holo-dirlock-extras" DESTDIR="$pkgdir" install

  cd "$srcdir/$pkgname"

  # Data dir
  install -d -m0711 "$pkgdir/var/lib/dirlock/"

  # Main binary
  install -m755 -D "target/release/dirlock" "$pkgdir/usr/bin/dirlock"

  # PAM module
  install -m644 -D "target/release/libpam_dirlock.so" "$pkgdir/usr/lib/security/pam_dirlock.so"

  # Polkit override so pam_dirlock can open the home directory and use the TPM
  install -m644 -D ../polkit-agent-helper-dirlock.conf "$pkgdir/usr/lib/systemd/system/polkit-agent-helper@.service.d/10-dirlock.conf"

  # systemd service (SteamOS integration)
  install -m644 -D ../dirlock-sddm.service "$pkgdir/usr/lib/systemd/system/dirlock-sddm.service"
  install -m755 -D ../dirlock-pam-config "$pkgdir/usr/lib/steamos/dirlock-pam-config"

  # tmpfiles.d configuration
  install -m644 -D ../tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/dirlock.conf"

  # udev rules
  install -m644 -D ../udev.rules "$pkgdir/usr/lib/udev/rules.d/70-dirlock.rules"

  # Debug and helper tools
  install -m755 -D "target/release/fscryptctl" "$pkgdir/usr/lib/dirlock/fscryptctl"

  # D-Bus service
  install -m644 -D "$srcdir/dirlock/data/com.valvesoftware.Dirlock1.xml" "$pkgdir/usr/share/dbus-1/interfaces/com.valvesoftware.Dirlock1.xml"
  install -m644 -D "$srcdir/dirlock/data/com.valvesoftware.Dirlock1.service" "$pkgdir/usr/share/dbus-1/system-services/com.valvesoftware.Dirlock1.service"
  install -m644 -D "$srcdir/dirlock/data/com.valvesoftware.Dirlock1.conf" "$pkgdir/usr/share/dbus-1/system.d/com.valvesoftware.Dirlock1.conf"
  install -m644 -D "$srcdir/dirlock/data/dirlockd.service" "$pkgdir/usr/lib/systemd/system/dirlockd.service"
  install -m755 -D "target/release/dirlockd" "$pkgdir/usr/lib/dirlock/dirlockd"
}
