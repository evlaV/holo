From 0e2c3e51700dac1653f9bd470dfe69ad3f1bc5a8 Mon Sep 17 00:00:00 2001
From: Vignesh Raman <vignesh.raman@collabora.com>
Date: Fri, 14 Aug 2026 14:02:50 +0530
Subject: [PATCH 1/2] wpa_supplicant: Avoid redundant rescan when 6 GHz was
 already covered

On suspend/resume, a regulatory domain change enabling 6 GHz
unconditionally forces a rescan before associating, even when the scan
that just completed already covered 6 GHz. This causes a redundant full
scan.

Check whether the last scan covered 6 GHz, and only force the rescan
when it did not.

Signed-off-by: Vignesh Raman <vignesh.raman@collabora.com>
---
 wpa_supplicant/events.c           | 29 ++++++++++++++++++++++++++++-
 wpa_supplicant/wpa_supplicant_i.h |  1 +
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
index 4f85da193..51002ba3b 100644
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -5926,7 +5926,10 @@ void wpa_supplicant_update_channel_list(struct wpa_supplicant *wpa_s,
 			wpa_dbg(ifs, MSG_INFO,
 				"Channel list changed: 6 GHz was enabled");
 
-			ifs->crossed_6ghz_dom = true;
+			/* Only force a rescan if the 6 GHz band has not been
+			 * scanned yet. */
+			if (!ifs->last_scan_covered_6ghz)
+				ifs->crossed_6ghz_dom = true;
 		}
 	}
 
@@ -6770,6 +6773,27 @@ static int wpas_pasn_auth(struct wpa_supplicant *wpa_s,
 #endif /* CONFIG_PASN */
 
 
+static void wpas_check_last_scan_6ghz(struct wpa_supplicant *wpa_s,
+				      struct scan_info *info)
+{
+	unsigned int i;
+
+	if (info->external_scan)
+		return;
+
+	wpa_s->last_scan_covered_6ghz = false;
+	if (!info->freqs)
+		return;
+
+	for (i = 0; i < info->num_freqs; i++) {
+		if (is_6ghz_freq(info->freqs[i])) {
+			wpa_s->last_scan_covered_6ghz = true;
+			break;
+		}
+	}
+}
+
+
 void wpa_supplicant_event(void *ctx, enum wpa_event_type event,
 			  union wpa_event_data *data)
 {
@@ -6923,6 +6947,9 @@ void wpa_supplicant_event(void *ctx, enum wpa_event_type event,
 			break;
 		}
 
+		if (data)
+			wpas_check_last_scan_6ghz(wpa_s, &data->scan_info);
+
 		if (!(data && data->scan_info.external_scan) &&
 		    os_reltime_initialized(&wpa_s->scan_start_time)) {
 			struct os_reltime now, diff;
diff --git a/wpa_supplicant/wpa_supplicant_i.h b/wpa_supplicant/wpa_supplicant_i.h
index cd763693f..00291dfda 100644
--- a/wpa_supplicant/wpa_supplicant_i.h
+++ b/wpa_supplicant/wpa_supplicant_i.h
@@ -1694,6 +1694,7 @@ struct wpa_supplicant {
 
 	bool is_6ghz_enabled;
 	bool crossed_6ghz_dom;
+	bool last_scan_covered_6ghz;
 	bool last_scan_all_chan;
 	bool last_scan_non_coloc_6ghz;
 	bool support_6ghz;
-- 
