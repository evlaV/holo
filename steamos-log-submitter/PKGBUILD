# Maintainer: Vicki Pfau <vi@endrift.com>

pkgname=steamos-log-submitter
pkgver=0.8.3
pkgrel=1
pkgdesc="SteamOS Log Submitter"
url="https://github.com/evlav/steamos-log-submitter"
arch=('any')
license=('LGPL2.1')
source=("git+https://github.com/evlav/steamos-log-submitter.git#tag=$pkgver")
sha256sums=('50b1ac542851dafde538836fc9bc25096db557b3d5aeff3e4da5862923415295')
depends=('python>=3.14' 'python<3.15' 'python-dbus-next' 'python-httpx' 'python-minidump' 'python-psutil' 'python-pyalsa' 'python-pyelftools' 'systemd' 'google-breakpad')
makedepends=('git' 'python-setuptools' 'python-wheel' 'python-pip')
checkdepends=('python-pytest' 'python-pytest-asyncio')
optdepends=('umr: enhanced amdgpu crash logging')
conflicts=('breakpad-hook')

package() {
	cd steamos-log-submitter
	make install DESTDIR="$pkgdir"
	pip install --root "$pkgdir" ./
}

check() {
	cd steamos-log-submitter
	dbus-run-session pytest
}
