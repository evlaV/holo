package() {
    local modules_files
    modules_files=(
	'modules-load.d_holo-hid-preload.conf'
	'modules-load.d_holo-ntsync.conf'
    )
    echo "Installing modules-load.d files:"
    for file in "${modules_files[@]}"; do
	install -v -D -m 0644 "${file}" "${pkgdir}"/usr/lib/modules-load.d/"${file/modules-load.d_/}"
    done

    local sysctl_files
    sysctl_files=(
	'sysctl.d_20-holo-mtu-probing.conf'
	'sysctl.d_20-holo-net-timeout.conf'
	'sysctl.d_20-holo-sched.conf'
        'sysctl.d_30-holo-splitlock.conf'
        'sysctl.d_30-holo-vm.conf'
    )
    echo "Installing sysctl.d files:"
    for file in "${sysctl_files[@]}"; do
        install -v -D -m 0644 "${file}" "${pkgdir}"/usr/lib/sysctl.d/"${file/sysctl.d_/}"
    done
}
