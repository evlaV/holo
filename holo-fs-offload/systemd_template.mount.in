[Unit]
Description=Holo Filesystem Offload - @BIND_MOUNT_PATH@

[Mount]
What=@OFFLOAD_BASE_PATH@@BIND_MOUNT_PATH@
Where=@BIND_MOUNT_PATH@
Type=none
Options=bind

[Install]
WantedBy=holo-fs-offload.target
